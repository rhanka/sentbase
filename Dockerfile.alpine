# `make image` compiles musl in the pinned toolchain and supplies a restricted,
# normalized context containing only this file and the executable.
# `make image-integration` validates SQL and recovery under USER opendb.

FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc

# Use the certificate bundle already frozen into the base digest. No live APK
# repository or package resolution participates in this build.
RUN test "$(apk info -v 2>/dev/null | grep '^ca-certificates-bundle-')" = 'ca-certificates-bundle-20260413-r0' && \
    addgroup -S opendb && adduser -S -G opendb opendb && \
    mkdir -p /var/lib/opendb && chown opendb:opendb /var/lib/opendb

# Pre-built static-musl binary from the containerized toolchain.
COPY target/x86_64-unknown-linux-musl/release/opendb-node /usr/local/bin/opendb-node

USER opendb
EXPOSE 5432 8080 7300 9100
ENTRYPOINT ["/usr/local/bin/opendb-node"]
CMD ["--help"]
